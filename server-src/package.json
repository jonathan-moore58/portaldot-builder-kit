{
  "name": "portaldot-dev-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Portaldot V3 chain tools for coding assistants (MCP server). By the Bridge Zero team.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen-knowledge.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/gen-knowledge.mjs && node build.mjs",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:live": "node --test --test-concurrency=1 \"test/live/*.test.ts\"",
    "test:server": "node test/server.test.mjs",
    "gen:metadata": "node scripts/gen-metadata.mjs",
    "test": "npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@polkadot/api": "17.0.2",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
